[sub_resource type="Shader" id="WeaponWaveletShader"]
code = "shader_type canvas_item;
render_mode unshaded;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear;
uniform vec4 wave_color : source_color = vec4(0.10, 0.88, 1.00, 1.00);
uniform float distortion_strength : hint_range(0.0, 0.02, 0.0001) = 0.002;
uniform float ring_radius : hint_range(0.0, 1.0, 0.01) = 0.58;
uniform float ring_softness : hint_range(0.01, 0.30, 0.01) = 0.14;
uniform float wave_opacity : hint_range(0.0, 1.0, 0.01) = 0.55;

void fragment() {
	vec4 vertex_color = COLOR;
	vec2 centered = UV - vec2(0.5);
	float centered_length = max(length(centered), 0.0001);
	float radius = centered_length * 2.0;
	float ring_distance = abs(radius - ring_radius);
	float ring = 1.0 - smoothstep(0.0, ring_softness, ring_distance);
	float texture_mask = texture(TEXTURE, UV).a;
	float alpha = ring * texture_mask * wave_opacity * vertex_color.a;
	vec2 direction = centered / centered_length;
	vec2 screen_offset = direction * distortion_strength * alpha;
	vec4 displaced_screen = texture(screen_texture, SCREEN_UV + screen_offset);
	vec3 tinted_screen = displaced_screen.rgb + wave_color.rgb * alpha * 0.22;
	COLOR = vec4(tinted_screen, alpha);
}
"

[sub_resource type="ShaderMaterial" id="WeaponWaveletMaterial"]
