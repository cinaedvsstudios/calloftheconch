[gd_resource type="Resource" load_steps=7 format=3]

[ext_resource type="Script" path="res://rebuild_v3/features/tutorial_cuttlefish/tutorial_hint_library.gd" id="1_library"]
[ext_resource type="Script" path="res://rebuild_v3/features/tutorial_cuttlefish/tutorial_hint_definition.gd" id="2_definition"]

[sub_resource type="Resource" id="HintIntroWelcome"]
script = ExtResource("2_definition")
hint_id = &"intro_welcome"
text = "Hello, Hylas! I'll swim nearby for a while. If you need help, watch for my ink."
display_duration = 7.0
dismiss_mode = 0
required_action = &""
show_only_once = true
ink_scale = 1.0
text_color = Color(0.17, 0.67, 0.82, 1)

[sub_resource type="Resource" id="HintTailFlipRock"]
script = ExtResource("2_definition")
hint_id = &"tail_flip_rock"
text = "That rock is blocking the passage. Press Shift + Space to bash it aside with your tail."
display_duration = 8.0
dismiss_mode = 2
required_action = &"tail_flip"
show_only_once = true
ink_scale = 1.0
text_color = Color(0.17, 0.67, 0.82, 1)

[sub_resource type="Resource" id="HintSpeedRunCurrent"]
script = ExtResource("2_definition")
hint_id = &"speed_run_current"
text = "That current is too strong for ordinary swimming. Hold a direction and press Shift to begin a Speed Run."
display_duration = 8.0
dismiss_mode = 2
required_action = &"speed_run"
show_only_once = true
ink_scale = 1.0
text_color = Color(0.17, 0.67, 0.82, 1)

[sub_resource type="Resource" id="HintConchFirstUse"]
script = ExtResource("2_definition")
hint_id = &"conch_first_use"
text = "Something is hidden nearby. Press Space to sound the conch and disturb the water around you."
display_duration = 8.0
dismiss_mode = 2
required_action = &"conch"
show_only_once = true
ink_scale = 1.0
text_color = Color(0.17, 0.67, 0.82, 1)

[resource]
script = ExtResource("1_library")
hints = Array[ExtResource("2_definition")]([SubResource("HintIntroWelcome"), SubResource("HintTailFlipRock"), SubResource("HintSpeedRunCurrent"), SubResource("HintConchFirstUse")])
